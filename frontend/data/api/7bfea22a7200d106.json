idad y la conecti","anuncios":2,"paginas":[{"page_name":"Hora 25 ","page_id":"202153429654408","anuncios":1,"afiliacion":null},{"page_name":"NOBOA","page_id":"512140358639284","anuncios":1,"afiliacion":null}],"n_paginas":2,"n_textos":2,"huellas":["92cc5736db9c","c002add99546"],"revision":null,"financiadores":["Ecuador Resuleve","HORA 25"],"financiadores_distintos":true,"mismo_partido":"","gasto_medio":199,"impresiones_medias":44999,"primer_anuncio":"2025-09-22","ultimo_anuncio":"2025-09-22","dias":0,"similitud_minima":0.92,"ejemplo_link":"https://www.facebook.com/ads/library/?id=818884060568613","coincidencias":2},{"texto":"Somos el equipo que viene con compromiso, propuestas reales y ganas de revivir Carchi y el País 💪\n\nVota todo 5-66 🗳️\n\n#LuisaPresidenta 🩵 #JoséVallejoAsambleísta 🇨🇬","anuncios":3,"paginas":[{"page_name":"Revolución Ciudadana 5 Carchi","page_id":"106101235139518","anuncios":2,"afiliacion":null},{"page_name":"José Luis Vallejo","page_id":"116776913499922","anuncios":1,"afiliacion":null}],"n_paginas":2,"n_textos":1,"huellas":["032f9476bc4e"],"revision":null,"financiadores":["Jose Luis Vallejo"],"financiadores_distintos":false,"mismo_partido":"","gasto_medio":148,"impresiones_medias":42498,"primer_anuncio":"2025-02-05","ultimo_anuncio":"2025-02-07","dias":2,"similitud_minima":1.0,"ejemplo_link":"https://www.facebook.com/ads/library/?id=2092769481185015","coincidencias":2},{"texto":"No dejes que el futuro solo quede en recuerdos… ¡Construyámoslo juntos con #LuisaPresidenta! ✊🔥\n\n#JoséVallejoAsambleísta #VamosaRevivirEcuador","anuncios":2,"paginas":[{"page_name":"Revolución Ciudadana 5 Carchi","page_id":"106101235139518","anuncios":1,"afiliacion":null},{"page_name":"José Luis Vallejo","page_id":"116776913499922","anuncios":1,"afiliacion":null}],"n_paginas":2,"n_textos":1,"huellas":["4cd332163f60"],"revision":null,"financiadores":["Jose Luis Vallejo"],"financiadores_distintos":false,"mismo_partido":"","gasto_medio":99,"impresiones_medias":19999,"pri