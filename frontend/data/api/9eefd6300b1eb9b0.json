ision":null,"financiadores":["Data crew","Día a Dia Ecuador"],"financiadores_distintos":true,"mismo_partido":"","gasto_medio":199,"impresiones_medias":102499,"primer_anuncio":"2026-08-04","ultimo_anuncio":"2026-08-06","dias":2,"similitud_minima":1.0,"ejemplo_link":"https://www.facebook.com/ads/library/?id=2841710112892147","coincidencias":1},{"texto":"¿Desde cuándo un trastorno como el déficit de atención es motivo de burla?\n\nMiles de niños y jóvenes enfrentan esto todos los días. Lo mínimo que merecen es respeto, no sarcasmos.\n\nVamos a defender a nuestros niños.\nVamos a defender a nuestra gente.\n\n#SaludMental #Ecuador  #LuisaGonzález #DanielNoboa","anuncios":4,"paginas":[{"page_name":"Te cuento las plenas","page_id":"101817481367973","anuncios":2,"afiliacion":null},{"page_name":"Informados Ec","page_id":"464038400783405","anuncios":2,"afiliacion":null}],"n_paginas":2,"n_textos":1,"huellas":["f78b25246ba0"],"revision":null,"financiadores":["Informados Ec","TE CUENTO LAS PLENAS"],"financiadores_distintos":true,"mismo_partido":"","gasto_medio":198,"impresiones_medias":62048,"primer_anuncio":"2025-04-04","ultimo_anuncio":"2025-04-05","dias":1,"similitud_minima":1.0,"ejemplo_link":"https://www.facebook.com/ads/library/?id=1410790029917534","coincidencias":7},{"texto":"Usuarios en redes sociales se quejan de la campaña sucia de Luisa en Youtube.","anuncios":4,"paginas":[{"page_name":"Hora 25 ","page_id":"202153429654408","anuncios":2,"afiliacion":null},{"page_name":"Santo Domingo TV","page_id":"1506981042871386","anuncios":2,"afiliacion":null}],"n_paginas":2,"n_textos":1,"huellas":["680b1d95072c"],"revision":null,"financiadores":["HORA 25","SANTO DOMINGO TV"],"financiadores_distintos":true,"mismo_partido":"","gasto_medio":198,"impresiones_medias":9148,"primer_anuncio":"2025-04-04","ultimo_anuncio":"2025-04-05","dias":1,"similitud_minima":1.0,"ejemplo_link":"https://www.facebook.com/ads/library/?id=681183540952825","coincidencias":10},{"texto":"🔴URGENTE: Luisa Gonz