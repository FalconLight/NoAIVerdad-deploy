# Claves de API para NoAIVerdad Backend

# Configuración del Servidor FastAPI
PORT=8000
HOST=0.0.0.0

# Las credenciales de proveedores se guardan en Realtime Database:
# /config/api_keys (GNEWS_API_KEY, GOOGLE_FACT_CHECK_API_KEY,
# X_API_BEARER_TOKEN, META_AD_LIBRARY_TOKEN or FB_META_ACCESS_TOKEN,
# GROK_API_KEY, BLUESKY_HANDLE, BLUESKY_APP_PASSWORD).

# Credenciales privadas del colector; nunca las incluyas en el frontend ni Git.
# Descarga una clave JSON de cuenta de servicio desde Firebase Console > Configuración > Cuentas de servicio.
GOOGLE_APPLICATION_CREDENTIALS=C:/ruta/privada/firebase-service-account.json
FIREBASE_DATABASE_URL=https://noaiverdad-72aba-default-rtdb.firebaseio.com

# El servidor recolecta al iniciar y repite cada 6 horas (21600 segundos).
NEWS_REFRESH_INTERVAL_SECONDS=21600
NEWS_SYNC_CONCURRENCY=3

# --- Fuentes opcionales; todas se pueden poner en backend/.env.local (no versionado) ---
# Las claves también pueden vivir en Firebase (/config/api_keys); el archivo local tiene prioridad.
# GNEWS_API_KEY=
# GOOGLE_FACT_CHECK_API_KEY=

# --- Biblioteca de Anuncios de Meta (anuncios políticos) ---
# La integración está APAGADA por defecto (decisión del equipo). Para encenderla:
# META_INTEGRATION_ENABLED=true        # o FB_META_API_ENABLED=true en Firebase /config/api_keys
# META_AD_LIBRARY_TOKEN=               # token de usuario con identidad confirmada
# META_GRAPH_VERSION=v23.0
# AD_LIBRARY_COUNTRY=EC
# Por defecto se descargan TODOS los anuncios políticos y de temas sociales de Ecuador (búsqueda «*»), no solo los que contienen ciertas palabras:
# unas diez palabras clave traían menos de 4 mil de los más de 22 mil anuncios de 120 días, y los locales (Galápagos, municipios) quedaban fuera.
# Solo hace falta cambiarlo para restringir la descarga a palabras concretas, separadas por comas:
# AD_LIBRARY_TERMS=*
# AD_LIBRARY_DAYS=120
# La descarga completa (medida el 2026-11-05: 22.642 anuncios) son unas 65 consultas y tarda unos 8 minutos; Meta rechaza una de cada cuatro páginas de 500
# y la app la repite sola más pequeña. Se repite como mucho una vez por hora y mientras se renueva la app sigue mostrando los datos anteriores.
# Con ~22 mil anuncios el backend usa unos 500 MB de memoria y la copia local ocupa unos 50 MB.
# AD_LIBRARY_LIMIT=500                 # anuncios por consulta (50 a 1000); si Meta tarda mucho, la página se encoge sola
# AD_LIBRARY_PAGES=80                  # tope de consultas por término (con 500 por página cubre 40 mil anuncios)
# AD_LIBRARY_TIMEOUT=45                # segundos de espera por consulta
# AD_LIBRARY_CACHE_MIN=60              # minutos que vale una descarga antes de renovarla
# AD_LIBRARY_SEGUNDO_PLANO=true        # false: al vencer la caché la petición espera la descarga nueva en lugar de recibir los datos anteriores
# AD_LIBRARY_MIN_REGION_PCT=0.05
# META_APP_ID=                         # solo para tools/renovar_token_meta.py (token de 60 días)
# META_APP_SECRET=                     # secreto de la app: solo en .env.local

# --- API oficial de X (pago por uso; opción futura, hoy desactivada) ---
# X_BEARER_TOKEN=
# X_MAX_RESULTS=10
# X_CACHE_MIN=60
# X_DAILY_REQUEST_CAP=40
